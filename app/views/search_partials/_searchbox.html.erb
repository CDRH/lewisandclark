<div class="row searchbox">
  <div class="col-md-12">
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="row">
          <div class="col-md-12">
            <%= form_tag(search_path, :method => "get", role: "search", :class => "input-group") do %>
              <%= hidden_field_tag(:qfield, "text") %>
              <%= render partial: "search_partials/date_hidden_fields" %>
              <%= text_field_tag(:qtext, params[:qtext], :placeholder => "Search for...", :class => "form-control", aria: { label: "Search" }) %>

              <%= render partial: "search_partials/facet_hidden_fields" %>

              <span class="input-group-btn">
                <%= submit_tag "Search", class: "btn btn-primary", name: nil, data: { disable_with: false } %>
              </span>
            <% end %>
          </div>
          <div class="col-xs-8">
            <%= render partial: "search_partials/help" %>
            <%= link_to "Browse All Items", search_path({ :all => true }) %>
          </div>
          <div class="col-xs-4 text-right">
            <%= link_to "Reset Search", search_path({}), :class => "clear_main_search_text" %>
          </div>
        </div> <!-- /row -->
      </div> <!-- /panel-body -->
    </div> <!-- /panel-default -->
  </div> <!-- /col-md-12 -->
</div> <!-- /row /searchbox -->
